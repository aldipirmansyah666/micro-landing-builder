# Contoh konfigurasi environment — salin ke .env.local lalu isi nilainya.
# JANGAN commit file .env.local yang berisi secret.
# Untuk deploy Vercel: isi nilai yang sama di Project Settings → Environment Variables.

# --- Database (Supabase Postgres) ---
# Pakai Transaction Pooler (port 6543) agar aman di serverless Vercel:
# Project Settings → Database → Connection string → Transaction pooler.
# Contoh: postgresql://postgres.xxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- Supabase (URL publik + service role untuk upload Storage server-side) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# Ambil di Project Settings → API Keys → service_role (RAHASIA, hanya server!).
SUPABASE_SERVICE_ROLE_KEY=
# Opsional (belum dipakai kode saat ini, untuk kebutuhan client-side kelak):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# --- Clerk Auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Opsional (belum dipakai kode saat ini):
# CLERK_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Pembayaran PRO ---
PRO_PRICE_IDR=49000
# Isi salah satu (Midtrans diprioritaskan bila keduanya ada):
# MIDTRANS_SERVER_KEY=xxx
# Sandbox (default): https://app.sandbox.midtrans.com
# Produksi: set MIDTRANS_IS_PRODUCTION=true (base jadi https://app.midtrans.com)
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_API_BASE_URL=https://app.sandbox.midtrans.com
# XENDIT_SECRET_KEY=xxx
# XENDIT_CALLBACK_TOKEN=xxx
