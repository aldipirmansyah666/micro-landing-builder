{
  "name": "micro-landing-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/patch-opennext-load-manifest.mjs",
    "preview": "node scripts/patch-opennext-load-manifest.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/patch-opennext-load-manifest.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "node scripts/patch-opennext-load-manifest.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@clerk/nextjs": "^7.9.14",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.150.0"
  }
}
